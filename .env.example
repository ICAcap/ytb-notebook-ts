# PostgreSQL connection string — used by Prisma at runtime (pooling OK)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=""

# Direct (non-pooled) connection — used by Prisma for migrations only
# On Supabase/Neon: use the "direct" URL, not the pooler
DIRECT_URL=""

# Secret key for BetterAuth session signing — any long random string
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public base URL of this app (no trailing slash)
# Dev: http://localhost:3000 | Prod: https://your-domain.com
BETTER_AUTH_URL=""

# Google OAuth credentials
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# YouTube Data API v3 key (for fetching video titles server-side)
# Get from: https://console.cloud.google.com → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=""
